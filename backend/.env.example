# Port des HTTP-Servers (Default: 3000; auf dem Produktivserver 3002, siehe deploy/DEPLOYMENT.md)
PORT=3000

# MongoDB-Verbindung. Auskommentiert lassen, um den lokalen
# JSON-Datei-Store (backend/data/db.json) zu verwenden.
# MONGODB_URI=mongodb://127.0.0.1:27017/veranstaltungszeitplaner

# Ablageordner für hochgeladene Bilder (relativ zu backend/, Default: uploads)
UPLOAD_DIR=uploads

# Optional: schützt die Startseite (Plan anlegen) mit einem Passwort (HTTP Basic Auth,
# Nutzername ist beliebig/wird ignoriert). Bestehende Pläne bleiben über ihre
# Bearbeitungs-/Freigabelinks erreichbar, unabhängig von diesem Passwort.
# Auskommentiert lassen, um das Anlegen neuer Pläne weiterhin offen zu lassen.
# CREATE_PASSWORD=bitte-eigenes-passwort-eintragen
